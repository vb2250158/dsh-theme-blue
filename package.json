{
  "name": "dsh-theme-blue",
  "description": "Blue light and dark palettes, settings glyphs and reversible styles for DeepSeek Harness Web",
  "version": "0.1.0-rc.8.20",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "keywords": ["dsh-plugin", "theme", "skin", "blue"],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <5.0.0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-alpha.1 <0.3.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "src",
    "scripts/build.mjs",
    "themes",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "tests/*.test.mjs",
    "docs",
    "locale",
    "icon.svg",
    "ICON_LICENSE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-theme-blue.git"
  },
  "homepage": "https://github.com/vb2250158/dsh-theme-blue#readme",
  "bugs": {
    "url": "https://github.com/vb2250158/dsh-theme-blue/issues"
  },
  "scripts": {
    "test": "node --test tests/theme-blue-client.test.mjs",
    "test:lifecycle": "node --test tests/theme-blue-lifecycle.test.mjs",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "react": "19.2.0",
    "lucide-static": "1.52.0"
  },
  "icon": "./icon.svg"
}
