{
  "name": "dsh-theme-blue",
  "description": "Private blue theme foundation for the DeepSeek Harness web client",
  "version": "0.1.0-rc.8.7",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-alpha.1 <0.3.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "src",
    "tsconfig.json",
    "tsdown.config.ts",
    "themes",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "tests/theme-blue-client.test.mjs",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-theme-blue.git"
  },
  "homepage": "https://github.com/vb2250158/dsh-theme-blue#readme",
  "bugs": {
    "url": "https://github.com/vb2250158/dsh-theme-blue/issues"
  },
  "scripts": {
    "test": "node --test tests/theme-blue-client.test.mjs",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
